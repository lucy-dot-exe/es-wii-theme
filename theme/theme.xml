<?xml version="1.0" encoding="UTF-8"?>
<!--
Theme:   Cartridge
Made for ArkOS's EmulationStation at 640x480 (R36S, RG351V, RGB10S, ...), in the style of the Wii's menu.
The images in art/ and assets/ are drawn by ../generator. Change them there, not here.
-->
<!-- defaultView: game lists open as the grid of channels, unless UI Settings picks another view. -->
<theme defaultView="grid">
  <formatVersion>7</formatVersion>

  <!-- The clock sits in the middle, above the dock, like the Wii's. -->
  <view name="screen">
    <text name="clock">
      <pos>0.30 0.68</pos>
      <size>0.40 0.085</size>
      <alignment>center</alignment>
      <fontPath>./fonts/MPLUSRounded1c-Medium.ttf</fontPath>
      <fontSize>0.07</fontSize>
      <color>A0A0A0</color>
    </text>
  </view>

  <view name="menu">
    <menuBackground name="menubg">
      <color>F7F7F7</color>
    </menuBackground>
    <menuText name="menutitle">
      <fontPath>./fonts/MPLUSRounded1c-Bold.ttf</fontPath>
      <fontSize>0.05</fontSize>
      <color>505050</color>
    </menuText>
    <menuText name="menutext">
      <fontPath>./fonts/MPLUSRounded1c-Medium.ttf</fontPath>
      <fontSize>0.04</fontSize>
      <color>505050</color>
      <selectorColor>34BEED</selectorColor>
      <selectedColor>FFFFFF</selectedColor>
      <separatorColor>E0E0E0</separatorColor>
    </menuText>
    <menuTextSmall name="menutextsmall">
      <fontPath>./fonts/MPLUSRounded1c-Regular.ttf</fontPath>
      <fontSize>0.03</fontSize>
      <color>8C8C8C</color>
    </menuTextSmall>
    <menuText name="menufooter">
      <fontPath>./fonts/MPLUSRounded1c-Regular.ttf</fontPath>
      <fontSize>0.03</fontSize>
      <color>8C8C8C</color>
    </menuText>
  </view>

  <!-- The system view: the Wii menu. The carousel is the middle row of channels; the rows above and below are
       empty slots in the background. The background and the blue frame are static extras, so they stay put while
       the channels slide under the frame. -->
  <view name="system">
    <image name="background" extra="static">
      <pos>0 0</pos>
      <size>1 1</size>
      <path>./assets/menu.png</path>
      <zIndex>0</zIndex>
    </image>

    <carousel name="systemcarousel">
      <type>horizontal</type>
      <pos>0 0.2625</pos>
      <size>1 0.2042</size>
      <color>00000000</color>
      <logoSize>0.30 0.2042</logoSize>
      <logoScale>1</logoScale>
      <maxLogoCount>3</maxLogoCount>
      <zIndex>40</zIndex>
    </carousel>

    <!-- The selected channel's animation (the picture bobbing, a shine crossing it), over the channel once the
         carousel stops. Its first frame is the channel's PNG, and ES fades it in, so the channel comes alive
         without a jump. Static, so it doesn't slide with the system's extras (a screen width) while the channels
         slide a third of one. -->
    <video name="channelanimation" extra="static">
      <origin>0.5 0.5</origin>
      <pos>0.5 0.3646</pos>
      <size>0.30 0.2042</size>
      <path>./art/${system.theme}.mp4</path>
      <delay>0.5</delay>
      <zIndex>42</zIndex>
    </video>

    <image name="frame" extra="static">
      <origin>0.5 0.5</origin>
      <pos>0.5 0.3646</pos>
      <size>0.325 0.2375</size>
      <path>./assets/frame.png</path>
      <zIndex>45</zIndex>
    </image>

    <image name="logo">
      <path>./art/${system.theme}.png</path>
    </image>

    <text name="logoText">
      <fontPath>./fonts/MPLUSRounded1c-ExtraBold.ttf</fontPath>
      <fontSize>0.06</fontSize>
      <color>6A6A6A</color>
    </text>

    <!-- Where the Wii shows the date. -->
    <text name="systemInfo">
      <pos>0.25 0.815</pos>
      <size>0.50 0.05</size>
      <alignment>center</alignment>
      <fontPath>./fonts/MPLUSRounded1c-Medium.ttf</fontPath>
      <fontSize>0.034</fontSize>
      <color>8C8C8C</color>
      <backgroundColor>00000000</backgroundColor>
      <forceUppercase>false</forceUppercase>
    </text>
  </view>

  <!-- Every game list: the system's band across the top with its name. -->
  <view name="basic, detailed, grid, video">
    <image name="header" extra="true">
      <pos>0 0</pos>
      <size>1 0.125</size>
      <path>./art/${system.theme}-header.png</path>
      <zIndex>5</zIndex>
    </image>

    <text name="systemName" extra="true">
      <text>${system.fullName}</text>
      <pos>0.04 0</pos>
      <size>0.75 0.1083</size>
      <alignment>left</alignment>
      <fontPath>./fonts/MPLUSRounded1c-Bold.ttf</fontPath>
      <fontSize>0.05</fontSize>
      <color>FFFFFF</color>
      <zIndex>6</zIndex>
    </text>

    <image name="logo">
      <visible>false</visible>
    </image>
    <text name="logoText">
      <visible>false</visible>
    </text>
  </view>

  <!-- The lists: the games in the white panel on the left, the art and description in the one on the right. -->
  <view name="basic, detailed, video">
    <image name="background" extra="true">
      <pos>0 0</pos>
      <size>1 1</size>
      <path>./assets/gamelist.png</path>
      <zIndex>0</zIndex>
    </image>

    <textlist name="gamelist">
      <pos>0.042 0.175</pos>
      <size>0.50 0.49</size>
      <fontPath>./fonts/MPLUSRounded1c-Medium.ttf</fontPath>
      <fontSize>0.038</fontSize>
      <lineSpacing>1.15</lineSpacing>
      <alignment>left</alignment>
      <horizontalMargin>0.015</horizontalMargin>
      <primaryColor>505050</primaryColor>
      <secondaryColor>0D96D6</secondaryColor>
      <selectedColor>0D86C6</selectedColor>
      <selectorColor>FFFFFF</selectorColor>
      <selectorImagePath>./assets/selector.png</selectorImagePath>
      <selectorImageTile>false</selectorImageTile>
    </textlist>
  </view>

  <!-- A list without scraped data (basic) shows the placeholder where the art would be. -->
  <view name="basic">
    <image name="noArt" extra="true">
      <origin>0.5 0.5</origin>
      <pos>0.7773 0.325</pos>
      <maxSize>0.355 0.30</maxSize>
      <path>./assets/noart.png</path>
      <zIndex>10</zIndex>
    </image>
  </view>

  <view name="detailed, video">
    <image name="md_image">
      <origin>0.5 0.5</origin>
      <pos>0.7773 0.325</pos>
      <maxSize>0.355 0.30</maxSize>
      <default>./assets/noart.png</default>
      <zIndex>10</zIndex>
    </image>

    <video name="md_video">
      <origin>0.5 0.5</origin>
      <pos>0.7773 0.325</pos>
      <maxSize>0.355 0.30</maxSize>
      <delay>1</delay>
      <showSnapshotNoVideo>true</showSnapshotNoVideo>
      <showSnapshotDelay>true</showSnapshotDelay>
      <default>./assets/noart.png</default>
      <zIndex>11</zIndex>
    </video>

    <image name="md_marquee, md_thumbnail">
      <visible>false</visible>
    </image>

    <text name="md_description">
      <pos>0.605 0.508</pos>
      <size>0.345 0.163</size>
      <fontPath>./fonts/MPLUSRounded1c-Regular.ttf</fontPath>
      <fontSize>0.028</fontSize>
      <color>707070</color>
      <lineSpacing>1.0</lineSpacing>
    </text>

    <!-- 640x480 has no room for the rest of the metadata. -->
    <text name="md_name, md_lbl_rating, md_lbl_releasedate, md_lbl_developer, md_lbl_publisher, md_lbl_genre, md_lbl_players, md_lbl_lastplayed, md_lbl_playcount, md_developer, md_publisher, md_genre, md_players, md_playcount">
      <visible>false</visible>
    </text>
    <datetime name="md_releasedate, md_lastplayed">
      <visible>false</visible>
    </datetime>
    <rating name="md_rating">
      <visible>false</visible>
    </rating>
  </view>

  <!-- The grid, the default game list: the games as channels, four by three, like the Wii's menu. The tiles stay
       put and the blue outline moves; the background has an empty slot under each tile, so a system with few
       games shows the rest of the page empty. The selected game's name is in the dock, where the date is in the
       system view. -->
  <view name="grid">
    <image name="background" extra="true">
      <pos>0 0</pos>
      <size>1 1</size>
      <path>./assets/grid.png</path>
      <zIndex>0</zIndex>
    </image>
    <imagegrid name="gamegrid">
      <pos>0.03 0.15</pos>
      <size>0.94 0.5375</size>
      <margin>0.01875 0.025</margin>
      <autoLayout>4 3</autoLayout>
      <autoLayoutSelectedZoom>1</autoLayoutSelectedZoom>
      <imageSource>image</imageSource>
      <showVideoAtDelay>1500</showVideoAtDelay>
      <gameImage>./assets/noart-tile.png</gameImage>
      <folderImage>./assets/noart-tile.png</folderImage>
    </imagegrid>
    <!-- minSize: the art and the video fill the tile, cropped. The tile's bezel rounds its corners: the art can't
         have roundCorners, because ES then doesn't draw the tile's video. -->
    <gridtile name="default">
      <padding>6 6 6 6</padding>
      <backgroundImage>./assets/tile.png</backgroundImage>
      <backgroundCornerSize>16 16</backgroundCornerSize>
      <backgroundColor>FFFFFFFF</backgroundColor>
      <imageColor>FFFFFFFF</imageColor>
      <imageSizeMode>minSize</imageSizeMode>
    </gridtile>
    <gridtile name="selected">
      <backgroundImage>./assets/tile-selected.png</backgroundImage>
    </gridtile>
    <text name="md_name">
      <pos>0.20 0.80</pos>
      <size>0.60 0.06</size>
      <alignment>center</alignment>
      <fontPath>./fonts/MPLUSRounded1c-Bold.ttf</fontPath>
      <fontSize>0.036</fontSize>
      <color>707070</color>
    </text>
    <image name="md_image, md_marquee, md_thumbnail">
      <visible>false</visible>
    </image>
    <text name="md_description, md_lbl_rating, md_lbl_releasedate, md_lbl_developer, md_lbl_publisher, md_lbl_genre, md_lbl_players, md_lbl_lastplayed, md_lbl_playcount, md_developer, md_publisher, md_genre, md_players, md_playcount">
      <visible>false</visible>
    </text>
    <datetime name="md_releasedate, md_lastplayed">
      <visible>false</visible>
    </datetime>
    <rating name="md_rating">
      <visible>false</visible>
    </rating>
  </view>

  <!-- The button prompts, along the bottom of the dock. -->
  <view name="system, basic, detailed, grid, video">
    <helpsystem name="help">
      <pos>0.03 0.935</pos>
      <fontPath>./fonts/MPLUSRounded1c-Medium.ttf</fontPath>
      <fontSize>0.022</fontSize>
      <textColor>7A7A7A</textColor>
      <iconColor>34BEED</iconColor>
    </helpsystem>
  </view>
</theme>
